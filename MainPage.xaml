<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AeroSpaceEFB.ViewModels"
             x:Class="AeroSpaceEFB.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F172A">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <!-- Gesamtes Seitenlayout in Zeilen: 1. Header oben, 2. Hauptinhalt darunter -->
    <Grid RowDefinitions="Auto, *">

        <Border Grid.Row="0" BackgroundColor="Black" StrokeThickness="0" Padding="15,10">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Links: Zurück-Button -->
                <Button Grid.Column="0" 
                Text="← Menü" 
                Clicked="OnBackToMenuClicked"
                BackgroundColor="#334155" 
                TextColor="White" 
                FontSize="14" 
                CornerRadius="6" 
                HeightRequest="40"
                VerticalOptions="Center" />

                <!-- Mitte/Links: Großes PNG-Logo OHNE Text -->
                <HorizontalStackLayout Grid.Column="1" Margin="20,0,0,0" VerticalOptions="Center">
                    <!-- Passe HeightRequest an, um das Logo beliebig groß zu machen (z. B. 60, 80 oder 100) -->
                    <Image Source="app_logo.png" 
                   HeightRequest="80" 
                   HorizontalOptions="Start"
                   VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- SCREEN LOCK BUTTON -->
                <Button Grid.Column="3" 
                            Text="🔒 Lock Screen" 
                            Clicked="OnToggleScreenLockClicked" 
                            BackgroundColor="#334155" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8"/>

                <!-- Rechts: Subtiler Zusatz (Optional, kann auch gelöscht werden) -->
            </Grid>
        </Border>

        <!-- 2. HAUPTINHALT (Zweispaltig: Links Flugzeuge/Checklisten, Rechts Items) -->
        <!-- 2. HAUPTINHALT (Zweispaltig) -->
        <Grid Grid.Row="1" ColumnDefinitions="280, *">

            <!-- LINKER BILDSCHIRMRAND: Flugzeuge & Checklisten -->
            <Border Grid.Column="0" BackgroundColor="#1E293B" StrokeThickness="0" Margin="0,1,1,0">
                <ScrollView>
                    <VerticalStackLayout Padding="15" Spacing="15">

                        <!-- FLUGZEUG AUSWAHL & LÖSCHEN -->
                        <Label Text="FLUGZEUG" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8" Margin="0,5,0,0"/>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                            <Picker Grid.Column="0"
                            ItemsSource="{Binding AircraftList}" 
                            ItemDisplayBinding="{Binding TailNumberOrModel}" 
                            SelectedItem="{Binding SelectedAircraft}"
                            TextColor="White"
                            Title="Flugzeug wählen..." 
                            TitleColor="#64748B"
                            BackgroundColor="#0F172A" />

                            <!-- Flugzeug Löschen Button -->
                            <Button Grid.Column="1" 
                            Text="🗑️" 
                            Command="{Binding DeleteAircraftCommand}" 
                            CommandParameter="{Binding SelectedAircraft}"
                            BackgroundColor="#DC2626" 
                            TextColor="White" 
                            WidthRequest="40" 
                            ToolTipProperties.Text="Ausgewähltes Flugzeug löschen"/>
                        </Grid>

                        <!-- Neues Flugzeug hinzufügen -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                            <Entry Grid.Column="0" Placeholder="Neues Flugzeug..." Text="{Binding NewAircraftName}" TextColor="White" PlaceholderColor="#64748B" FontSize="12"/>
                            <Button Grid.Column="1" Text="+" Command="{Binding AddAircraftCommand}" WidthRequest="40" BackgroundColor="#38BDF8" TextColor="#0F172A" FontAttributes="Bold"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#334155" Margin="0,5"/>

                        <!-- CHECKLISTEN -->
                        <Label Text="CHECKLISTEN" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8"/>

                        <!-- Neue Checkliste erstellen -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                            <Entry Grid.Column="0" Placeholder="Neue Liste..." Text="{Binding NewChecklistTitle}" TextColor="White" PlaceholderColor="#64748B" FontSize="12"/>
                            <Button Grid.Column="1" Text="+" Command="{Binding AddChecklistCommand}" WidthRequest="40" BackgroundColor="#38BDF8" TextColor="#0F172A" FontAttributes="Bold"/>
                        </Grid>

                        <!-- Liste der Checklisten mit Löschen-Button -->
                        <CollectionView ItemsSource="{Binding SelectedAircraft.Checklists}" 
                            SelectedItem="{Binding SelectedChecklist, Mode=TwoWay}" 
                            SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <!-- ✅ KORREKT: Saubere Ausrichtung im Grid oder StackLayout -->
                                <DataTemplate>
                                    <Border BackgroundColor="#1E293B" 
            Margin="0,4" 
            Padding="12,8" 
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">

                                            <!-- Spalte 0: Emergency Icon -->
                                            <Label Grid.Column="0" 
                   Text="⚠️" 
                   IsVisible="{Binding IsEmergency}" 
                   VerticalOptions="Center" />

                                            <!-- Spalte 1: Checklisten-Titel -->
                                            <Label Grid.Column="1" 
                   Text="{Binding Title}" 
                   TextColor="White" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   LineBreakMode="TailTruncation" />

                                            <!-- Spalte 2: Completed Checkmark -->
                                            <Label Grid.Column="2" 
                   Text="✓" 
                   TextColor="#22C55E" 
                   FontSize="16"
                   FontAttributes="Bold"
                   IsVisible="{Binding IsCompleted}" 
                   VerticalOptions="Center" />

                                            <!-- Spalte 3: LÖSCHEN-BUTTON (wieder da) -->
                                            <Button Grid.Column="3"
                    Text="✕"
                    TextColor="#EF4444"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="5,0"
                    HeightRequest="36"
                    WidthRequest="36"
                    CornerRadius="18"
                    Command="{Binding BindingContext.DeleteChecklistCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}"
                    VerticalOptions="Center" />

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- RECHTER BILDSCHIRMRAND: Checklisten-Items Abarbeiten & Löschen -->
            <ScrollView Grid.Column="1">
                <VerticalStackLayout Padding="20" Spacing="15" MaximumWidthRequest="800">

                    <!-- Titel der gewählten Checkliste -->
                    <Entry Text="{Binding SelectedChecklist.Title}" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

                    <!-- Action-Buttons -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="JSON Sichern" Command="{Binding SaveCommand}" BackgroundColor="#0284C7" TextColor="White" />
                        <Button Grid.Column="1" Text="JSON Laden" Command="{Binding LoadCommand}" BackgroundColor="#16A34A" TextColor="White" />
                        <Button Grid.Column="2" Text="Reset" Command="{Binding ResetCommand}" BackgroundColor="#EA580C" TextColor="White" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,5" />

                    <!-- Punkt hinzufügen -->
                    <Label Text="PUNKT HINZUFUEGEN" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8" />
                    <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                        <Entry Grid.Column="0" Placeholder="Gegenstand (z.B. Magnetos)" Text="{Binding NewItemTitle}" TextColor="White" PlaceholderColor="#64748B" />
                        <Entry Grid.Column="1" Placeholder="Aktion (z.B. BOTH)" Text="{Binding NewItemAction}" TextColor="White" PlaceholderColor="#64748B" />
                        <Button Grid.Column="2" Text="+" Command="{Binding AddItemCommand}" WidthRequest="50" FontAttributes="Bold" BackgroundColor="#38BDF8" TextColor="#0F172A" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,5" />

                    <!-- Checklisten-Items mit Einzel-Löschbutton -->
                    <Label Text="CHECKLISTE ABARBEITEN" FontSize="12" FontAttributes="Bold" TextColor="#38BDF8" />

                    <CollectionView ItemsSource="{Binding SelectedChecklist.Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#1E293B" BackgroundColor="#1E293B" StrokeThickness="1" Margin="0,4" Padding="12" StrokeShape="RoundRectangle 8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Color="#38BDF8" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Action}" FontSize="16" TextColor="#38BDF8" FontAttributes="Bold" VerticalOptions="Center" />

                                        <!-- Einzelnen Punkt Löschen Button -->
                                        <Button Grid.Column="3" 
                                        Text="✕" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=DeleteItemCommand}" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="Transparent" 
                                        TextColor="#EF4444" 
                                        FontSize="14" 
                                        WidthRequest="30" 
                                        HeightRequest="30" 
                                        Padding="0" 
                                        VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
        <!-- LADEBILDSCHIRM OVERLAY (wird automatisch angezeigt, wenn IsLoading = true ist) -->
        <Grid Grid.Row="0" 
          Grid.RowSpan="2" 
          BackgroundColor="#0F172A" 
          IsVisible="{Binding IsLoading}" 
          ZIndex="99">

            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

                <!-- Großes EFB Logo im Ladebildschirm -->
                <Image Source="app_logo2.png" 
                   HeightRequest="400" 
                   HorizontalOptions="Center" />

                <!-- MAUI Lade-Spinner -->
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               Color="#38BDF8" 
                               WidthRequest="50" 
                               HeightRequest="50" />

                <Label Text="Checklisten werden geladen..." 
                   TextColor="White" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

                <Label Text="Datenbank wird synchronisiert" 
                   TextColor="#64748B" 
                   FontSize="12" 
                   HorizontalOptions="Center" 
                   Margin="0,-10,0,0"/>
            </VerticalStackLayout>
        </Grid>
        <Grid x:Name="ScreenLockOverlay" 
              Grid.Row="0" 
              Grid.RowSpan="2" 
              BackgroundColor="#CC000000" 
              IsVisible="False" 
              InputTransparent="False">

            <Border BackgroundColor="#0F172A" 
                    Stroke="#38BDF8" 
                    StrokeThickness="2" 
                    Padding="30" 
                    StrokeShape="RoundRectangle 16" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Label Text="🔒 COCKPIT TOUCH LOCK" TextColor="#38BDF8" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Der Bildschirm ist gegen versehentliche Touches gesperrt." TextColor="White" FontSize="13" HorizontalTextAlignment="Center"/>

                    <Button Text="🔓 Entsperren" 
                            Clicked="OnToggleScreenLockClicked" 
                            BackgroundColor="#0284C7" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            HeightRequest="50" 
                            Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>