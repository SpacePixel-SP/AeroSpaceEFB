<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AeroSpaceEFB.MainMenuPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0F172A">

    <!-- Gesamtes Seitenlayout: Zeile 0 = Header, Zeile 1 = Inhalt -->
    <Grid RowDefinitions="Auto, *">

        <!-- 1. BENUTZERDEFINIERTE GROSSE HEADER-LEISTE (Identisch mit MainPage) -->
        <Border Grid.Row="0" BackgroundColor="#1E293B" StrokeThickness="0" Padding="15,10">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Platzhalter links für die Ausrichtung (da im Hauptmenü kein Zurück-Button existiert) -->
                <BoxView Grid.Column="0" WidthRequest="0" />

                <!-- Mitte/Links: Großes PNG-Logo OHNE Text -->
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Image Source="app_logo.png" 
                           HeightRequest="80" 
                           Aspect="AspectFill"
                           HorizontalOptions="Start"
                           VerticalOptions="Fill" />
                </HorizontalStackLayout>

                <!-- Rechts: Subtiler Hinweis -->
                <Label Grid.Column="2" 
                       Text="Companion EFB v0.2.0-alpha" 
                       FontSize="14" 
                       TextColor="#64748B" 
                       VerticalOptions="Center" 
                       Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- 2. HAUPTMENÜ-INHALT -->
        <!-- 2. HAUPTMENÜ-INHALT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="30" 
                                 Spacing="20" 
                                 VerticalOptions="Center" 
                                 HorizontalOptions="Center" 
                                 MaximumWidthRequest="450">

                <!-- Text in der Mitte über den Knöpfen -->
                <Label Text="AeroSpaceEFB" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       TextColor="#38BDF8" 
                       HorizontalOptions="Center" />

                <Label Text="Electronic Flight Bag" 
                       FontSize="16" 
                       TextColor="#94A3B8" 
                       HorizontalOptions="Center" 
                       Margin="0,-10,0,15" />

                <!-- Feature-Buttons -->
                <Button Text="✈️ Checklisten" 
                        Clicked="OnChecklistClicked" 
                        BackgroundColor="#1E293B" 
                        TextColor="White" 
                        FontSize="18" 
                        FontAttributes="Bold"
                        HeightRequest="60" 
                        CornerRadius="10" />

                <Button Text="📝 ATC Scratchpad" 
                        Clicked="OnOpenScratchpadClicked" 
                        BackgroundColor="#1E293B" 
                        TextColor="White" 
                        FontSize="18" 
                        FontAttributes="Bold" 
                        CornerRadius="10" 
                        HeightRequest="60" 
                        Margin="0,5"/>

                <Button Text="🧮 Calculations" 
                        Clicked="OnOpenCalculationsClicked" 
                        BackgroundColor="#1E293B" 
                        TextColor="White" 
                        FontSize="18" 
                        FontAttributes="Bold" 
                        CornerRadius="10" 
                        HeightRequest="60" 
                        Margin="0,5"/>

                <Button Text="⚙️ Einstellungen" 
                        Clicked="OnOpenSettingsClicked" 
                        BackgroundColor="#1E293B" 
                        TextColor="White" 
                        FontSize="18" 
                        HeightRequest="60" 
                        CornerRadius="10" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>